[Unit]
Description=belfry reverse SSH tunnel to EC2
After=network-online.target
Wants=network-online.target

[Service]
User=youruser
# Two reverse forwards land on EC2's loopback only (sshd's GatewayPorts=no
# default keeps them off the public interface):
#   :8080 → Orin :80   — Caddy reverse-proxies into this for the public site
#   :2222 → Orin :22   — `ssh -J example.com youruser@127.0.0.1 -p 2222`
#                        from a laptop while travelling
Environment="AUTOSSH_GATETIME=0"
# Retry every 30s instead of autossh's 600s default. Pairs with EC2's
# ClientAlive* drop-in (cloud/sshd-keepalive.conf): after an unclean Orin
# reboot, sshd frees the orphaned :8080 forward at ~90s, and this decides how
# long we then sit idle before rebinding. At the default that was up to 10
# more minutes of public-site downtime for no reason.
Environment="AUTOSSH_POLL=30"
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -i /home/youruser/.ssh/bellfry_login \
  -R 127.0.0.1:8080:127.0.0.1:80 \
  -R 127.0.0.1:2222:127.0.0.1:22 \
  youruser@example.com
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
