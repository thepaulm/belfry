[Unit]
Description=Belfry DVR (MediaMTX + FastAPI viewer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/code/belfry
Environment=DVR_PORT=9090
Environment=PATH=/home/youruser/.local/bin:/usr/local/bin:/usr/bin:/bin
# Mobile-app auth (Phase A0). See dvr/auth.py and runme.sh.
#   /etc/belfry/auth.env       — BELFRY_JWT_SECRET, BELFRY_GOOGLE_CLIENT_IDS
#   /etc/belfry/allowed-emails — one email per line (same format as EC2)
EnvironmentFile=-/etc/belfry/auth.env
Environment=BELFRY_ALLOWED_EMAILS_FILE=/etc/belfry/allowed-emails
ExecStart=/home/youruser/code/belfry/scripts/run.sh
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
