[Unit]
Description=Belfry inference (per-camera object-detection event recorder)
After=network-online.target belfry.service
Wants=network-online.target
# Inference now reads from MediaMTX's loopback RTSP, so MediaMTX (in
# belfry.service) must be up first. Soft dependency only — the recorder
# has retry-on-read-fail logic for the case where MediaMTX restarts.

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/code/belfry
Environment=PATH=/home/youruser/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/youruser/code/belfry/scripts/run-inference.sh
# Generous stop timeout: each recorder thread needs to release its
# capture, flush in-flight event runs, and close its SQLite handle.
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
