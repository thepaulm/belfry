[Unit]
Description=Belfry DVR (MediaMTX + FastAPI viewer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paulm
Group=paulm
WorkingDirectory=/home/paulm/code/belfry
Environment=DVR_PORT=9090
Environment=PATH=/home/paulm/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/paulm/code/belfry/scripts/run.sh
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
